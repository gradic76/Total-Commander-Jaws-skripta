[Options]
; JAWS's shared totalcmd64.jcf sets IndicateSelected=1, which adds "selected" in menus
; and the drive menu; 2 adds "Not Selected" to every unmarked item (measured 2026-11-17).
; 0 says neither; the scripts say "selected" for marked files themselves.
IndicateSelected=0
; JAWSInsertKey (which Insert keys are the JAWS key: 0 none, 1 numeric, 2 extended, 3 both):
; 1 matches the default Quick Settings choice (Extended Insert marks, single press).
; The scripts rewrite it in the user's copy when the Insert settings change (TcApplyInsertKeys).
JAWSInsertKey=1
